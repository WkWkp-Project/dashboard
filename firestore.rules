rules_version = '2';

// Paste this whole file into Firebase Console → Firestore Database → Rules → Publish.
// Or deploy via `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }
    function isAdmin() {
      // wkwk team — admins are anyone with an @team.wkwkp.com email
      return signedIn() && email().matches('.*@team[.]wkwkp[.]com');
    }
    function isOwnerOf(camp) {
      // A campaign belongs to exactly one member, identified by clientEmail.
      return signedIn()
        && camp.keys().hasAll(['clientEmail'])
        && camp.clientEmail is string
        && camp.clientEmail == email();
    }

    // Master DB — wkwkp only. Used for handoff (full snapshot).
    match /dbs/{id} {
      allow read, write: if isAdmin();
    }

    // Member docs — admin manages; the member themselves can read their own.
    match /members/{memberEmail} {
      allow read: if isAdmin() || (signedIn() && memberEmail == email());
      allow create, update, delete: if isAdmin();
    }

    // Per-campaign mirror — the single clientEmail can read; admin writes.
    match /campaigns/{id} {
      allow read: if isAdmin()
        || (resource != null && isOwnerOf(resource.data));
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Presence (lightweight, optional). Any signed-in user can heartbeat
    // their own key; admins can read the full list.
    match /presence/{key} {
      allow read: if isAdmin();
      allow write: if signedIn();
    }
  }
}
